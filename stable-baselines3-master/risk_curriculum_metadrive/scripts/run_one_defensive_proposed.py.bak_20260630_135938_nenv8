#!/usr/bin/env python
from __future__ import annotations
import argparse, subprocess, sys
from pathlib import Path
ROOT_DIR = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT_DIR))
from racrl.config import RewardWeights, get_variant_config
from racrl.experiment import evaluate, train

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--seed", type=int, required=True)
    parser.add_argument("--n-envs", type=int, default=10)
    parser.add_argument("--timesteps", type=int, default=1_000_000)
    parser.add_argument("--root", type=Path, required=True)
    parser.add_argument("--ttc-threshold", type=float, default=8.0)
    parser.add_argument("--target-speed", type=float, default=18.0)
    parser.add_argument("--device", default="cuda")
    args = parser.parse_args()
    args.root.mkdir(parents=True, exist_ok=True)
    (args.root / "evaluations").mkdir(exist_ok=True)
    (args.root / "figures").mkdir(exist_ok=True)
    run_dir = args.root / "runs" / f"defensive_proposed_ppo_s{args.seed}"
    config = get_variant_config("proposed", "ppo", seed=args.seed, timesteps=args.timesteps)
    config.horizon = 1500
    config.n_envs = args.n_envs
    config.reward_weights = RewardWeights(
        ttc=6.0,
        cost=40.0,
        overspeed=3.0,
        target_speed_kmh=args.target_speed,
        progress=40.0,
        success_bonus=55.0,
        crash_penalty=120.0,
        out_of_road_penalty=120.0,
        ttc_threshold=args.ttc_threshold,
    )
    config.stage2_success = 0.50
    config.stage2_cost = 0.25
    config.demote_grace_episodes = 20
    config.allow_demote = True
    model_path = train(config, run_dir, device=args.device)
    out_csv = args.root / "evaluations" / f"defensive_proposed_ppo_s{args.seed}.csv"
    evaluate(config, model_path, out_csv, device=args.device, densities=(0.00, 0.08, 0.15), episodes=50, n_envs=args.n_envs)
    for cmd in [
        ["scripts/plot_results.py", "--input-dir", str(args.root / "evaluations"), "--output-dir", str(args.root / "figures"), "--runs-dir", str(args.root / "runs")],
        ["scripts/plot_return_figures.py", "--runs-dir", str(args.root / "runs"), "--eval-dir", str(args.root / "evaluations"), "--output-dir", str(args.root / "figures")],
        ["scripts/plot_framework_diagram.py", "--output-dir", str(args.root / "figures")],
        ["scripts/write_run_report.py", "--experiment-root", str(args.root), "--preset", args.root.name],
    ]:
        subprocess.run([sys.executable, *cmd], check=True)
if __name__ == "__main__":
    main()
