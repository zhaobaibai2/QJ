    {
      "name": "medium",
      "traffic_density": 0.1,
      "map_blocks": 3,
      "accident_prob": 0.0
    },
    {
      "name": "hard",
      "traffic_density": 0.25,
      "map_blocks": 5,
      "accident_prob": 0.03
    }
  ],
  "curriculum_window": 20,
  "promote_success": 0.6,
  "promote_cost": 0.35,
  "demote_success": 0.28,
  "demote_grace_episodes": 60,
  "eval_episodes": 30,
  "eval_freq": 20000,
  "policy_layers": [
    256,
    256
  ]
